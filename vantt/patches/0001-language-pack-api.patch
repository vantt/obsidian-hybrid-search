+
+  it('applies rescore without dropping candidates or admitting unknown paths', async () => {
+    await configure({});
+    const plain = await search('bread', { limit: 0 });
+    await configure({ rescore: 'reverse' });
+    const rescored = await search('bread', { limit: 0 });
