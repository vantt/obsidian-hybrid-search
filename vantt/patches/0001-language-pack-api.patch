+import type { QueryAnalysis } from './types.js';
+
+/**
+ * The analysis of a query when no pack contributes: no view branches and the
+ * original query for BM25 and the embedder. Used when a pack's analyzeQuery fails,
+ * so that query runs exactly like upstream search.
+ */
+export function noopAnalysis(): QueryAnalysis {
+  return { viewQueries: {} };
+}
diff --git a/src/language/tokens.ts b/src/language/tokens.ts
new file mode 100644
index 0000000..0928cdc
--- /dev/null
+++ b/src/language/tokens.ts
@@ -0,0 +1,182 @@
+/**
+ * Token arithmetic for mapping matches in a projected view back to original text.
+ *
+ * FTS5's unicode61 tokenizer is emulated in JS: a token is a run of letters,
+ * numbers, combining marks and private-use characters plus any `tokenchars`.
+ * Original text is tokenized with the view's rules minus `_` and the continuation
+ * mark; a view token that contains `_` stands for as many original tokens as it has
+ * non-empty parts, and one that starts with the continuation mark stands for none
+ * (it belongs to the original token before it).
+ */
+import { VIEW_CONTINUATION } from './types.js';
+
+export interface TokenSpan {
+  start: number;
+  end: number;
+}
+
+export interface TokenizerRules {
+  ascii: boolean;
+  tokenChars: ReadonlySet<string>;
+  separators: ReadonlySet<string>;
+}
+
+const UNICODE_TOKEN_CHAR = /[\p{L}\p{N}\p{M}\p{Co}]/u;
+const ASCII_TOKEN_CHAR = /[A-Za-z0-9]/;
+
+function tokenizerArgs(spec: string): string[] {
+  const args: string[] = [];
+  for (const match of spec.matchAll(/'((?:[^']|'')*)'|"((?:[^"]|"")*)"|(\S+)/g)) {
+    args.push(match[1]?.replaceAll("''", "'") ?? match[2]?.replaceAll('""', '"') ?? match[3]!);
+  }
+  return args;
+}
+
+/** Boundary rules of an FTS5 tokenizer spec, or null when they cannot be emulated. */
+export function parseTokenizerRules(spec: string): TokenizerRules | null {
+  let args = tokenizerArgs(spec);
+  if (args[0] === 'porter') args = args.slice(1);
+  if (args.length === 0) args = ['unicode61'];
+  const [name, ...options] = args;
+  if (name !== 'unicode61' && name !== 'ascii') return null;
+  let tokenChars = '';
+  let separators = '';
+  for (let i = 0; i + 1 < options.length; i += 2) {
+    const key = options[i];
+    const value = options[i + 1]!;
+    if (key === 'tokenchars') tokenChars += value;
+    else if (key === 'separators') separators += value;
+    else if (key === 'categories') return null;
+  }
+  return {
+    ascii: name === 'ascii',
+    tokenChars: new Set(Array.from(tokenChars)),
+    separators: new Set(Array.from(separators)),
+  };
+}
+
+function isTokenChar(char: string, rules: TokenizerRules): boolean {
+  if (rules.separators.has(char)) return false;
+  if (rules.tokenChars.has(char)) return true;
+  if (rules.ascii) return char.codePointAt(0)! >= 0x80 || ASCII_TOKEN_CHAR.test(char);
+  return UNICODE_TOKEN_CHAR.test(char);
+}
+
+export function tokenize(text: string, rules: TokenizerRules): TokenSpan[] {
+  const tokens: TokenSpan[] = [];
+  let start = -1;
+  let index = 0;
+  for (const char of text) {
+    if (isTokenChar(char, rules)) {
+      if (start < 0) start = index;
+    } else if (start >= 0) {
+      tokens.push({ start, end: index });
+      start = -1;
+    }
+    index += char.length;
+  }
+  if (start >= 0) tokens.push({ start, end: index });
+  return tokens;
+}
+
+/** Rules for original text: the view's rules without `_`, the join character. */
+function sourceRules(rules: TokenizerRules): TokenizerRules {
+  const tokenChars = new Set(rules.tokenChars);
+  tokenChars.delete('_');
+  tokenChars.delete(VIEW_CONTINUATION);
+  return { ...rules, tokenChars };
+}
+
+function viewTokenWeight(token: string): number {
+  if (token.startsWith(VIEW_CONTINUATION)) return 0;
+  if (!token.includes('_')) return 1;
+  return token.split('_').filter(Boolean).length;
+}
+
+/**
+ * Map tokens highlighted in a projected view (between `markStart` and `markEnd`)
+ * to original token indexes. Returns null when the projection broke the token
+ * invariant, i.e. the weighted view token count differs from the original count.
+ */
+export function mapHighlightedTokens(
+  original: string,
+  highlighted: string,
+  rules: TokenizerRules,
+  markStart: string,
+  markEnd: string,
+): { tokens: TokenSpan[]; matched: Set<number> } | null {
+  const tokens = tokenize(original, sourceRules(rules));
+  const matched = new Set<number>();
+  let position = 0;
+  let inside = false;
+  let cursor = 0;
+  for (const token of tokenize(highlighted, rules)) {
+    for (; cursor < token.start; cursor++) {
+      const char = highlighted[cursor];
+      if (char === markStart) inside = true;
+      else if (char === markEnd) inside = false;
+    }
+    cursor = token.end;
+    const weight = viewTokenWeight(highlighted.slice(token.start, token.end));
+    if (inside) {
+      for (let k = 0; k < weight; k++) matched.add(position + k);
+      if (weight === 0 && position > 0) matched.add(position - 1);
+    }
+    position += weight;
+  }
+  if (position !== tokens.length) return null;
+  return { tokens, matched };
+}
+
+/**
+ * Cut a snippet of `windowSize` original tokens around the densest group of
+ * matches, marking each matched token, with FTS5-style ellipses.
+ */
+export function buildMarkedSnippet(
+  original: string,
+  tokens: readonly TokenSpan[],
+  matched: ReadonlySet<number>,
+  windowSize: number,
+  markStart: string,
+  markEnd: string,
+): string {
+  if (tokens.length === 0 || matched.size === 0) return '';
+  const hits = [...matched].sort((a, b) => a - b);
+  let best = { first: hits[0]!, last: hits[0]!, count: 0 };
+  for (let i = 0, j = 0; i < hits.length; i++) {
+    while (hits[i]! - hits[j]! >= windowSize) j++;
+    // j trails i: hits[j..i] fit in one window.
+    if (i - j + 1 > best.count) best = { first: hits[j]!, last: hits[i]!, count: i - j + 1 };
+  }
+  const spare = windowSize - (best.last - best.first + 1);
+  let start = Math.max(0, best.first - Math.floor(spare / 2));
+  start = Math.max(0, Math.min(start, tokens.length - windowSize));
+  const end = Math.min(tokens.length, start + windowSize);
+  let text = start === 0 ? '' : '...';
+  let offset = start === 0 ? 0 : tokens[start]!.start;
+  for (let i = start; i < end; i++) {
+    const token = tokens[i]!;
+    text += original.slice(offset, token.start);
+    const word = original.slice(token.start, token.end);
+    text += matched.has(i) ? `${markStart}${word}${markEnd}` : word;
+    offset = token.end;
+  }
+  text += end === tokens.length ? original.slice(offset) : '...';
+  return text;
+}
+
+/** Original words of the matched tokens, unique, in order of appearance. */
+export function matchedWords(
+  original: string,
+  tokens: readonly TokenSpan[],
+  matched: ReadonlySet<number>,
+): string[] {
+  const words: string[] = [];
+  for (const index of [...matched].sort((a, b) => a - b)) {
+    const token = tokens[index];
+    if (!token) continue;
+    const word = original.slice(token.start, token.end);
+    if (!words.includes(word)) words.push(word);
+  }
+  return words;
+}
diff --git a/src/language/types.ts b/src/language/types.ts
new file mode 100644
index 0000000..cfcb901
--- /dev/null
+++ b/src/language/types.ts
@@ -0,0 +1,169 @@
+/**
+ * Language pack contract (API version 1).
+ *
+ * A language pack is a separately installed ES module that adds language-specific
+ * lexical "views" of every note. Each view is indexed in its own FTS5 table and
+ * searched as one extra RRF branch. The core never rewrites the original text:
+ * notes, snippets and reads always return what the vault contains.
+ *
+ * The module's default export (or its `createPack` export) is either a
+ * `LanguagePackV1` object or a factory `(options) => LanguagePackV1 | Promise<…>`,
+ * where `options` is the parsed `OHS_LANGUAGE_PACK_OPTIONS` JSON.
+ */
+
+export type LanguagePackField = 'title' | 'aliases' | 'content';
+
+export interface LanguagePackView {
+  /** `[a-z][a-z0-9_]{0,15}`; becomes part of table names. */
+  name: string;
+  /** RRF weight of this view's branch. */
+  weight: number;
+  /** FTS5 tokenizer; defaults to `DEFAULT_VIEW_TOKENIZER`. */
+  tokenizer?: string;
+}
+
+export interface LanguagePackV1 {
+  apiVersion: 1;
+  id: string;
+  version: string;
+  /**
+   * Changes whenever anything that affects indexed view text changes. Called once
+   * per load, with the vault the pack was loaded for.
+   */
+  signature(ctx?: PackContext): string;
+  /** At most three views. */
+  views: ReadonlyArray<LanguagePackView>;
+  /**
+   * Pure, deterministic projection of one field into one view. It must keep the
+   * token invariant: tokenizing the result with the view tokenizer yields the same
+   * token sequence as tokenizing `text` with the same rules (`tokenchars` minus
+   * `_` and VIEW_CONTINUATION), with two exceptions. A view token may join adjacent
+   * source tokens with `_` and then counts as that many source tokens (word
+   * segmentation). A view token that starts with VIEW_CONTINUATION counts as no
+   * source token and belongs to the source token before it (compound splitting).
+   * Both characters must be in the view tokenizer's `tokenchars` to be used.
+   */
+  project(view: string, field: LanguagePackField, text: string): string;
+  /** Called once per query (and once per entry of `queries[]`). */
+  analyzeQuery(query: string, ctx: QueryContext): QueryAnalysis | Promise<QueryAnalysis>;
+  /** Views (subset of `views`) whose projected title/aliases feed the exact-alias branch. */
+  aliasViews?: ReadonlyArray<string>;
+  /** Query-time-only data version (synonyms, abbreviations). Never triggers a rebuild. */
+  queryCacheKey?(ctx?: PackContext): string;
+  /** Re-score fused candidates before reranking. May not drop candidates. */
+  rescore?(
+    candidates: ReadonlyArray<Candidate>,
+    analysis: QueryAnalysis,
+    ctx: QueryContext,
+  ): ReadonlyArray<RescoredCandidate> | Promise<ReadonlyArray<RescoredCandidate>>;
+}
+
+/** One term of a structured view query. */
+export interface ViewQueryTerm {
+  /** View text of one token, or of a phrase when it holds several tokens. */
+  text: string;
+  /** Match tokens that start with the (last) token of `text`. Default false: exact match. */
+  prefix?: boolean;
+}
+
+export interface QueryAnalysis {
+  /**
+   * Raw query text per view; the core sanitizes it and ORs every word as a prefix
+   * term (`"w"*`). null skips the branch unless `viewTerms` gives terms for the view.
+   */
+  viewQueries: Record<string, string | null>;
+  /**
+   * Structured query per view, ORed together. A string is an exact term or phrase;
+   * use `{ text, prefix: true }` for a prefix match. A non-empty array replaces
+   * `viewQueries[view]`; null or an empty array falls back to it.
+   */
+  viewTerms?: Record<string, ReadonlyArray<string | ViewQueryTerm> | null>;
+  /**
+   * RRF weight per view for this query only; a finite number >= 0 replaces the
+   * declared `views[].weight`. null or a missing entry keeps the declared weight.
+   * To drop a branch, set `viewQueries[view]` to null.
+   */
+  viewWeights?: Record<string, number | null>;
+  /** Query for the upstream BM25 branch; defaults to the original query. */
+  baseQuery?: string;
+  /** Query sent to the embedder; defaults to the original query. */
+  embedQuery?: string;
+  /** Exact-alias lookup key per alias view; null skips it. */
+  aliasKeys?: Record<string, string | null>;
+  /** Pack-private data passed to `rescore`. */
+  data?: unknown;
+  /** Diagnostics, returned with `explain` and logged with LOG_LEVEL=debug. */
+  debug?: Record<string, unknown>;
+}
+
+/** Context passed to `signature()` and `queryCacheKey()`. */
+export interface PackContext {
+  /** Absolute vault path, read-only, for user-maintained pack files. */
+  vaultPath: string;
+}
+
+export interface QueryContext extends PackContext {
+  /** Notes containing `term` and total occurrences, from the view's fts5vocab table. */
+  termStats(view: string, term: string): { docs: number; hits: number };
+  /** View terms starting with `prefix`, most frequent first. */
+  termsWithPrefix(
+    view: string,
+    prefix: string,
+    limit: number,
+  ): Array<{ term: string; docs: number }>;
+  /** Notes containing `phrase` as an exact phrase in the view. */
+  phraseDocs(view: string, phrase: string): number;
+  noteCount(): number;
+  /** Index data version; changes whenever any note is written. Key in-memory vocabulary caches on it. */
+  dbVersion(): number;
+}
+
+export interface Candidate {
+  path: string;
+  /** Hybrid score after RRF. */
+  score: number;
+  title: string;
+  /** Original-text snippet. */
+  snippet: string;
+  matchedViews: string[];
+  /** Original-text words matched through the views; empty when no view matched. */
+  matchedTerms: string[];
+  /** 1-based rank of this path in each branch; null when the branch missed it. */
+  rank: Record<string, number | null>;
+}
+
+export interface RescoredCandidate {
+  path: string;
+  score: number;
+}
+
+export const LANGUAGE_PACK_API_VERSION = 1;
+export const MAX_LANGUAGE_VIEWS = 3;
+export const VIEW_NAME_PATTERN = /^[a-z][a-z0-9_]{0,15}$/;
+export const DEFAULT_VIEW_TOKENIZER = "unicode61 remove_diacritics 0 tokenchars '+#'";
+/** WORD JOINER: prefix of extra view tokens split out of one source token. */
+export const VIEW_CONTINUATION = '\u2060';
+
+/** A validated pack plus the layout that defines its index tables. */
+export interface LoadedLanguagePack {
+  pack: LanguagePackV1;
+  views: ReadonlyArray<Required<LanguagePackView>>;
+  aliasViews: ReadonlyArray<string>;
+  /**
+   * Canonical JSON of everything that shapes the indexed view tables. Stored in
+   * `settings.language_pack`; a different value means the views must be rebuilt.
+   */
+  layout: string;
+  /** Distinct per load, so search caches never mix results of two pack instances. */
+  generation: number;
+}
+
+export interface LanguagePackStatus {
+  requested: string;
+  loaded: boolean;
+  id?: string;
+  version?: string;
+  signature?: string;
+  views?: string[];
+  error?: string;
+}
