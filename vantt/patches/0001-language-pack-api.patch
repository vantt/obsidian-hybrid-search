@@ -0,0 +1,80 @@
+/**
+ * Without a configured language pack, search must be indistinguishable from
+ * upstream. The snapshot was generated by this same file on pristine upstream
+ * v0.17.2, before the language-pack extension point existed.
+ */
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import path from 'node:path';
+import { afterAll, beforeAll, expect, it, vi } from 'vitest';
+import { BASELINE_QUERIES, writeLanguagePackVault } from './fixtures/language-pack-vault.js';
+
+const vault = mkdtempSync(path.join(tmpdir(), 'ohs-lang-baseline-'));
+process.env.OBSIDIAN_VAULT_PATH = vault;
+delete process.env.OHS_LANGUAGE_PACK;
+delete process.env.OHS_LANGUAGE_PACK_OPTIONS;
+
+vi.mock('../../src/inference/embedder.js', async (importOriginal) => {
+  const actual = await importOriginal<typeof import('../../src/inference/embedder.js')>();
+  const { fixtureVector: vector } = await import('./fixtures/language-pack-vault.js');
+  return {
+    ...actual,
+    activeModelName: () => 'fixture-model',
+    getEmbeddingDim: () => Promise.resolve(8),
+    getContextLength: () => Promise.resolve(512),
+    getDocumentTokenPolicy: () =>
+      Promise.resolve({ limit: 508, count: (text: string) => text.length / 4 }),
+    embedDetailed: vi.fn((texts: string[]) =>
+      Promise.resolve(texts.map((text) => ({ ok: true as const, embedding: vector(text) }))),
+    ),
+    embed: vi.fn((texts: string[]) => Promise.resolve(texts.map((text) => vector(text)))),
+  };
+});
+
+const { openIndexDatabase, createIndexService } =
+  await import('../../src/indexing/index-service.js');
+const { search } = await import('../../src/search/searcher.js');
+const { closeDb, getDb } = await import('../../src/storage/db.js');
+
+function round(value: unknown): unknown {
+  if (typeof value === 'number') return Math.round(value * 1e9) / 1e9;
+  if (Array.isArray(value)) return value.map(round);
+  if (value && typeof value === 'object')
+    return Object.fromEntries(Object.entries(value).map(([k, v]) => [k, round(v)]));
+  return value;
+}
+
+beforeAll(async () => {
+  writeLanguagePackVault(vault);
+  await openIndexDatabase();
+  const service = createIndexService();
+  try {
+    const result = await service.reindex();
+    expect(result.errors).toEqual([]);
+  } finally {
+    await service.close();
+  }
+});
+
+afterAll(() => {
+  closeDb();
+  rmSync(vault, { recursive: true, force: true });
+});
+
+it('creates no language-view tables without a pack', () => {
+  const tables = getDb()
+    .prepare("SELECT name FROM sqlite_master WHERE name LIKE '%lex%'")
+    .all() as Array<{ name: string }>;
+  expect(tables).toEqual([]);
+});
+
+it('returns exactly the upstream results without a pack', async () => {
+  const outcome: Array<{ query: string; options: Record<string, unknown>; results: unknown }> = [];
+  for (const { query, options } of BASELINE_QUERIES) {
+    const results = await search(query, options);
+    outcome.push({ query, options, results: round(JSON.parse(JSON.stringify(results))) });
+  }
+  await expect(JSON.stringify(outcome, null, 2) + '\n').toMatchFileSnapshot(
+    './fixtures/language-pack-baseline.snapshot.json',
+  );
+});
diff --git a/test/vantt/language-pack-tokens.test.ts b/test/vantt/language-pack-tokens.test.ts
