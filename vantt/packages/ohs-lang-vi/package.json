{
  "name": "ohs-lang-vi",
  "version": "0.2.0",
  "private": true,
  "description": "Vietnamese language pack for obsidian-hybrid-search (norm and fold views, query analysis, diacritic restoration, rescore)",
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    }
  },
  "files": ["build"],
  "engines": { "node": ">=22.22.0" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "fast-check": "4.10.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
